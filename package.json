{
  "name": "brh-registration-site",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone BigRed//Hacks registration portal",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "dev": "concurrently --kill-others --names frontend,backend \"npm run dev -w frontend\" \"npm run dev -w backend -- --exitcrash\"",
    "dev:localdb": "concurrently --kill-others --names frontend,backend \"npm run dev -w frontend -- --mode localdb\" \"DOTENV_CONFIG_PATH=.env.localdb.local npm run dev -w backend -- --exitcrash\"",
    "email:worker:localdb": "DOTENV_CONFIG_PATH=.env.localdb.local npm run email:worker -w backend",
    "build": "npm run build:frontend && npm run build:backend",
    "lint": "npm run lint -w frontend",
    "test": "node --test \"frontend/src/**/*.test.{ts,js}\" \"backend/src/**/*.test.{ts,js}\"",
    "test:database": "node --test supabase/tests/emailQueue.test.js supabase/tests/emailDeadline.test.js supabase/tests/emailTemplateStorage.test.js supabase/tests/releaseDecisionEmails.test.js"
  },
  "dependencies": {
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@netlify/functions": "^2.8.2",
    "concurrently": "^9.2.4"
  }
}
